    ["Skull Guitar"] = true,
    ["Cursed Dual Katana"] = true,
    ["Switch Melee"] = true,
    ["Eat Fruit"] = "",
    ["Snipe Fruit"] = "",
    ["Lock Fragment"] = 0,
    ["Buy Stuffs"] = true
